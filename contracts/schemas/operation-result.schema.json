{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.floodcaster.example.invalid/mobile/v1/operation-result.schema.json",
  "title": "Operation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment", "operation_id", "transport_state", "replay", "domain_outcome", "evidence_state", "determination_state", "acknowledged_at"],
  "properties": {
    "environment": { "const": "TEST_ONLY" },
    "operation_id": { "type": "string" },
    "transport_state": { "enum": ["ACKNOWLEDGED", "REJECTED_AT_BOUNDARY"] },
    "replay": { "type": "boolean" },
    "domain_outcome": { "enum": ["APPLIED", "VERIFY_REQUIRED", "REJECTED"] },
    "evidence_state": { "enum": ["UNASSESSED", "ADMITTED", "REJECTED"] },
    "determination_state": { "enum": ["NOT_ISSUED", "ISSUED"] },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "determination_id": { "type": ["string", "null"] },
    "certificate_id": { "type": ["string", "null"] },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  }
}
